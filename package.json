{
  "name": "playcanvas-jogo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:editor": "vite build --config vite.editor.config.ts",
    "publicar:editor": "npm run build:editor && node scripts/publicar-editor.mjs",
    "publicar:editor:teste": "node scripts/publicar-editor.mjs --dry-run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "playcanvas": "^2.24.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^2.1.3"
  }
}
